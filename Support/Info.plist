<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Husk</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- husk://open?id=<UUID> / husk://open?url=<percent-encoded> -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>org.example.husk.url</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>husk</string>
			</array>
		</dict>
	</array>

	<!-- ATS：只放开 WebView 内的明文 HTTP，app 自身发起的 URLSession 请求仍然强制 HTTPS。
	     这样 http:// 的站点能在 WKWebView 里打开，而图标抓取等 app 侧请求不会被降级。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>

	<!-- 只申请「添加到相册」。存主屏图标用得着往里写，用不着读用户的照片，
	     所以刻意不写 NSPhotoLibraryUsageDescription——那一条是完整读写权限。
	     站点设置里的「从相册选一张」走 PhotosPicker，是进程外选择器，本来就不需要权限。 -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>把站点图标存成 1024×1024 的图片，方便在「快捷指令」里作为主屏图标使用。</string>

	<!-- App Intents 把 intent 派发给场景（让快捷指令冷启动也不闪首页）要求 app
	     声明支持多场景，哪怕实际上只有一个窗口。见 Sources/App/HuskApp.swift 的
	     onAppIntentExecution。不写 UISceneConfigurations：场景配置由
	     AppDelegate.application(_:configurationForConnecting:options:) 给。 -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<!-- 整个 app 强制深色：首页是深色设计，同时让 WKWebView 的 prefers-color-scheme 跟着深色走 -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>

	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
